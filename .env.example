# --- App ---
APP_ENV=local                     # local | staging | production
APP_NAME="IDEA OS - Edith"
LOG_LEVEL=INFO
API_PORT=8080

# --- Security ---
# Fernet key used to encrypt OAuth tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Secret used to sign our own session JWTs. Generate with: openssl rand -hex 32
JWT_SIGNING_KEY=
JWT_ACCESS_TOKEN_TTL_MINUTES=60
JWT_REFRESH_TOKEN_TTL_DAYS=30

# --- Secret Manager backend ---
# env    -> read secrets from this .env file (local dev)
# gcp    -> read secrets from Google Cloud Secret Manager (staging/production)
SECRET_MANAGER_BACKEND=env
GCP_PROJECT_ID=

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://idea_os:idea_os@localhost:5432/idea_os

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- LLM (Intent Router / Function Calling) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=4096

# --- Embeddings (long-term memory) — OpenAI, since Anthropic has no embeddings endpoint ---
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Google OAuth ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
# Space-separated scopes requested at login (incremental auth per agent)
GOOGLE_OAUTH_SCOPES="openid email profile https://www.googleapis.com/auth/drive https://www.googleapis.com/auth/gmail.modify https://www.googleapis.com/auth/calendar https://www.googleapis.com/auth/spreadsheets"

# --- Single-user owner (this system has exactly one owner account) ---
OWNER_EMAIL=

# --- Reminders (Cloud Scheduler -> POST /api/v1/internal/reminders/run) ---
# There's no logged-in user in that context, so this header substitutes for
# a session JWT. Leave empty locally unless you're testing the endpoint —
# an empty secret always rejects the request, it never falls open.
SCHEDULER_SHARED_SECRET=
