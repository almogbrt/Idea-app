# Copy to terraform.tfvars (gitignored) and fill in your real values.
# Never commit terraform.tfvars — it holds live API keys and OAuth secrets.

project_id = "idet-502218"
region     = "us-central1"

owner_email = "you@example.com"

# console.anthropic.com -> API Keys
anthropic_api_key = "sk-ant-..."

# platform.openai.com -> API Keys (used only for long-term memory embeddings)
openai_api_key = "sk-..."

# Google Cloud Console -> APIs & Services -> Credentials -> your OAuth client
google_oauth_client_id     = "xxxxx.apps.googleusercontent.com"
google_oauth_client_secret = "GOCSPX-..."

# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
token_encryption_key = "..."

# neon.tech -> your project -> Connection string (paste as-is, postgresql://...)
neon_database_url = "postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require"

# upstash.com -> your Redis database -> TLS connection string (rediss://...)
upstash_redis_url = "rediss://default:password@xxxx.upstash.io:6379"

# Leave empty on the first `terraform apply` (the service doesn't exist yet).
# After the first deploy, set this to the printed service URL and re-apply
# to create the hourly reminders Cloud Scheduler job.
cloud_run_service_url = ""

# Green Invoice (חשבונית ירוקה) -> account menu -> Developer Tools -> API ID/Secret.
# Leave both at "unset" until you've rotated the secret (if it was ever pasted
# in plaintext anywhere) — the finance dashboard section just stays empty
# until these are configured.
green_invoice_api_id     = "unset"
green_invoice_api_secret = "unset"
